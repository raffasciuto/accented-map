rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /memos/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
